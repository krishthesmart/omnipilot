{
  "name": "omnipilot-cloudflare",
  "private": true,
  "description": "Runs OmniPilot on Cloudflare: a Worker in front of OmniPilot's container, with data kept in R2.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "typescript": "5.6.3",
    "wrangler": "4.146.0"
  }
}

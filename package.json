{
  "name": "omnipilot",
  "private": true,
  "version": "1.3.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node scripts/start.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "test": "npm run test --workspace server && npm run test:engine",
    "package:extension": "node scripts/package-extension.mjs",
    "train": "bash training/train.sh",
    "knowledge": "uv run --python 3.12 --with pyarrow==25.0.1 scripts/build-knowledge.py",
    "test:engine": "uv run --directory engine pytest -q",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "package:vscode": "node scripts/package-vscode.mjs",
    "share": "node scripts/share.mjs",
    "service:share": "npm run service:restart && node scripts/service.mjs wait && npm run share"
  },
  "description": "A private, local multi-agent assistant: specialists for code, learning, hardware and parental focus time, powered by a free on-device model.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^4.2.1",
    "zod": "~4.4.3"
  }
}

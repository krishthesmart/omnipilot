// Exports the routing/coordination data both engines need -- the specialist
// registry, router prompt + examples + output schema, follow-up rewriting, and
// the coordinator's patterns -- to shared/omnipilot.json, so the Python/LangGraph
// engine reads the same definitions instead of keeping a second copy.
// tests/shared.test.ts fails if the file is out of date:
//   npx tsx scripts/export-shared.mts --write
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { AGENT_NAMES } from "../src/types.js";
import { AGENT_SPECS, REVIEW_INTENT } from "../src/agents/registry.js";
import { EXAMPLES, ROUTING_SCHEMA, SAMPLES, SYSTEM_PROMPT } from "../src/router/routerModel.js";
import { TEACHING_ASK } from "../src/router/decisionModel.js";
import { FOLLOW_UP, MAX_TURNS, REWRITE_EXAMPLES, REWRITE_SCHEMA, REWRITE_SYSTEM, STOP } from "../src/lib/conversation.js";
import { CANNOT_HANDLE, CODE_FILE, FAILED_STATUSES, NEW_INSTRUCTION, REFLECT_SCHEMA, REFLECT_SYSTEM, SYNTHESIS_CLAUSE } from "../src/coordinator.js";

export const SHARED_FILE = path.join(path.dirname(fileURLToPath(import.meta.url)), "..", "..", "shared", "omnipilot.json");

const re = (r: RegExp) => ({ source: r.source, flags: r.flags });

export function sharedDefinitions() {
  return {
    about: "Generated by server/scripts/export-shared.mts from the TypeScript engine. Do not edit by hand.",
    agents: AGENT_NAMES.map((name) => {
      const s = AGENT_SPECS[name];
      return {
        name,
        description: s.description,
        keywords: s.keywords.map(re),
        narrow: Boolean(s.narrow),
        describesOneThing: Boolean(s.describesOneThing),
        buildsOn: (s.buildsOn ?? []).map((b) => ({ agent: b.agent, when: b.when ? re(b.when) : null, reason: b.reason })),
        budget: s.budget,
      };
    }),
    patterns: {
      reviewIntent: re(REVIEW_INTENT),
      teachingAsk: re(TEACHING_ASK),
      followUp: re(FOLLOW_UP),
      synthesisClause: re(SYNTHESIS_CLAUSE),
      newInstruction: re(NEW_INSTRUCTION),
      cannotHandle: re(CANNOT_HANDLE),
      codeFile: re(CODE_FILE),
    },
    router: { system: SYSTEM_PROMPT, examples: EXAMPLES, schema: ROUTING_SCHEMA, samples: SAMPLES },
    followUp: { maxTurns: MAX_TURNS, system: REWRITE_SYSTEM, schema: REWRITE_SCHEMA, examples: REWRITE_EXAMPLES, stopwords: [...STOP] },
    coordinator: { failedStatuses: [...FAILED_STATUSES], reflectSystem: REFLECT_SYSTEM, reflectSchema: REFLECT_SCHEMA },
  };
}

if (process.argv[1]?.endsWith("export-shared.mts")) {
  const json = JSON.stringify(sharedDefinitions(), null, 2) + "\n";
  if (process.argv.includes("--write")) {
    fs.writeFileSync(SHARED_FILE, json);
    console.log(`wrote ${SHARED_FILE}`);
  } else process.stdout.write(json);
}

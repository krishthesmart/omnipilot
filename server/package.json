{
  "name": "omnipilot-server",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage.enabled --coverage.include='src/**' --coverage.reporter=text-summary"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "e2b": "2.51.0",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "22.20.4",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
